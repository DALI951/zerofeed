{
  "manifest_version": 3,
  "name": "ZEROFEED — Anti-Scrolling & Deep Work Enforcer",
  "version": "1.0.0",
  "description": "Eliminates compulsive feeds, Instagram Reels, YouTube Shorts, and TikTok while preserving Instagram DMs, educational YouTube, and research.",
  "permissions": [
    "storage",
    "tabs",
    "webNavigation",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "ZEROFEED Control Center",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "dashboard.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["common/rule-engine.js", "content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "blocked.html",
        "dashboard.html",
        "common/default-rules.json"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
